# Server
NODE_ENV=development
PORT=9000
# Set to the exact number of trusted reverse proxies in production (for example, 1 for one load balancer).
TRUST_PROXY_HOPS=0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
# Optional CDN / public base for object URLs (no trailing slash)
S3_PUBLIC_BASE_URL=
# S3 setup: see infra/s3/README.md (CORS + public read policy for catalog media)
# When true, orphan cleanup logs candidates but does not delete (safe to run in staging)
S3_ORPHAN_CLEANUP_DRY_RUN=false

# Razorpay (use Test keys from Dashboard → Test mode → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: Dashboard → Checkout → Configuration → copy config ID for Test/Live
RAZORPAY_CHECKOUT_CONFIG_ID=

# Mail
# Driver: auto | console | ses | smtp
# auto picks ses → smtp → console based on available config.
# Add another system via mail.providers.ts + MAIL_DRIVER in env.ts.
MAIL_DRIVER=auto
MAIL_FROM_EMAIL=noreply@ecommerce.com
MAIL_FROM_NAME=Ecommerce

# Amazon SES (MAIL_DRIVER=ses) — uses AWS_* above
SES_CONFIGURATION_SET=

# SMTP (MAIL_DRIVER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Notification scheduler
ABANDONED_CART_HOURS=24
REVIEW_REQUEST_DELAY_DAYS=2

# Logging
LOG_LEVEL=info

# Sentry
SENTRY_DSN=

# Client
CLIENT_URL=http://localhost:5173

# Report exports — sync direct download (see docs/REPORT_EXPORT_RUNBOOK.md)
# REPORT_MAX_RANGE_DAYS=366
# REPORT_EXPORT_MAX_ROWS=500000
# REPORT_EXPORT_RATE_LIMIT_PER_MIN=5
# REPORT_EXPORT_CHUNK_SIZE=2000
# REPORT_EXPORT_WORKER_CONCURRENCY=1

# Async job-based exports (see export-module-plan/)
# EXPORT_WORKER_CONCURRENCY=2
# EXPORT_JOB_TTL_HOURS=48
# EXPORT_JOB_MAX_INACTIVITY_MINUTES=30

# Background workers: with START_WORKERS_IN_API=true (default in dev), email and
# schedulers run in the API process. User report exports are synchronous in the API —
# no separate export worker is required. Run npm run worker:dev only for scheduled
# weekly report emails or to isolate background jobs. In production, set false and
# run npm run worker separately.
START_WORKERS_IN_API=true
DB_POOL_MAX=20
EMAIL_TRANSACTIONAL_WORKER_CONCURRENCY=3
EMAIL_MARKETING_WORKER_CONCURRENCY=1

# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
# Authorized redirect URI must match GOOGLE_CALLBACK_URL (default: http://localhost:9000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Admin defaults (for seeder)
ADMIN_EMAIL=admin@ecommerce.com
ADMIN_PASSWORD=Admin@123
