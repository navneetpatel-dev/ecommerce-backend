{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadCatalogMedia",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET_NAME/*"
    },
    {
      "Sid": "DenyPublicKycDocuments",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET_NAME/*/vendors/*/kyc/*"
    }
  ]
}
