{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadCatalogMedia",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::ecommerce-317429618919-eu-north-1-an/*"
    },
    {
      "Sid": "DenyPublicKycDocuments",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::ecommerce-317429618919-eu-north-1-an/*/vendors/*/kyc/*"
    }
  ]
}
