{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Multi-vendor e-commerce platform backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:tickets": "sequelize-cli db:seed --seed 20240101000080-seed-support-tickets.js",
    "db:seed:bugs": "sequelize-cli db:seed --seed 20240101000081-seed-bug-reports.js",
    "db:seed:gallery": "sequelize-cli db:seed --seed 20240101000095-seed-product-gallery-images.js",
    "test": "tsx --tsconfig tsconfig.json --test 'src/**/__tests__/**/*.test.ts'",
    "docker:dev": "docker-compose up",
    "docker:dev:build": "docker-compose up --build",
    "docker:dev:down": "docker-compose down",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:build": "docker-compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/client-ses": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@types/cookie-parser": "^1.4.10",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.8",
    "sequelize": "^6.37.3",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "sequelize-cli": "^6.6.2",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
